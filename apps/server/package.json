{
  "name": "@sillage/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsup && mkdir -p dist/migrations && cp -r ../../packages/db/migrations/. dist/migrations/",
    "start": "node --max-old-space-size=256 dist/main.js",
    "migrate": "tsx src/cli/migrate.ts",
    "user:create": "tsx src/cli/user-create.ts",
    "search:reindex": "tsx src/cli/search-reindex.ts",
    "mcp:probe": "tsx src/cli/mcp-probe.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^8.0.4",
    "@fastify/websocket": "^11.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@sillage/codex-bindings": "workspace:*",
    "@sillage/db": "workspace:*",
    "@sillage/protocol": "workspace:*",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2"
  }
}
