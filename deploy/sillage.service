# User systemd unit.
# Installation:
#   cp deploy/sillage.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now sillage
#   loginctl enable-linger $USER   # keep daemon running after sign-out

[Unit]
Description=Sillage, plateforme de developpement agentique
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/projects/sillage
ExecStart=/usr/bin/node --max-old-space-size=256 %h/projects/sillage/apps/server/dist/main.js
Environment=NODE_ENV=production
# Systemd unit PATH lacks ~/.local/bin and global npm binaries:
# without this line, service cannot find agent CLIs.
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5

# Guardrail, not reservation: beyond this, kernel throttles service instead of
# letting the whole machine run out of memory. Agents and their dev servers
# (vite, bun: several GB each) are children. Fixed caps suit no machine: 2G,
# then 12G on a 62 GB machine, froze daemon itself (D state) without killing
# anything, making Sillage unreachable. Hence a share of installed RAM.
# Override: `systemctl --user edit sillage`, then [Service] MemoryHigh=...
MemoryHigh=75%

# Use journal, not a file: `journalctl --user -u sillage` should suffice for
# diagnosis, and systemd already manages rotation/retention.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sillage

[Install]
WantedBy=default.target
