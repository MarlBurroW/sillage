<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- User launchd agent (macOS), counterpart of sillage.service.tmpl, rendered by
   install.sh into ~/Library/LaunchAgents. Placeholders __NODE__, __NODE_DIR__,
   __INSTALL_DIR__, __DATA_DIR__, __HOME__, __SHELL__, and __LANG__ become absolute
   values: launchd expands neither ~ nor environment variables. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.marlburrow.sillage</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>--max-old-space-size=256</string>
    <string>__INSTALL_DIR__/current/server/main.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__INSTALL_DIR__/current</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>SILLAGE_WEB_ROOT</key>
    <string>__INSTALL_DIR__/current/web</string>
    <!-- Like systemd: identifies installer layout, enabling integrated updates. -->
    <key>SILLAGE_INSTALL_DIR</key>
    <string>__INSTALL_DIR__</string>
    <!-- launchd PATH stops at /usr/bin:/bin:/usr/sbin:/sbin: no Homebrew,
       ~/.local/bin, or global npm binaries, so no discoverable agent CLI. -->
    <key>PATH</key>
    <string>__NODE_DIR__:__HOME__/.local/bin:__HOME__/.npm-global/bin:__HOME__/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- Sillage terminal shell and locale: launchd supplies neither; without a locale
       zsh displays accented characters as byte sequences. Both come from the
       shell that launched the installer. -->
    <key>SHELL</key>
    <string>__SHELL__</string>
    <key>LANG</key>
    <string>__LANG__</string>
  </dict>

  <!-- Start at sign-in. -->
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart regardless of exit: integrated updates stop themselves and rely on
     restart. launchd spaces launches by at least 10 seconds, containing startup
     crash loops. -->
  <key>KeepAlive</key>
  <true/>
  <!-- Without type, launchd throttles CPU/I/O of service and children, including
     agents and their builds. -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <!-- No system journal like systemd: a file without rotation. -->
  <key>StandardOutPath</key>
  <string>__DATA_DIR__/logs/sillage.log</string>
  <key>StandardErrorPath</key>
  <string>__DATA_DIR__/logs/sillage.log</string>
</dict>
</plist>
