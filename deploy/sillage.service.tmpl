# User systemd unit rendered by install.sh.
# Placeholders __NODE__, __INSTALL_DIR__, and __HOME__ become absolute paths at
# installation: %h specifiers do not expand reliably in old systemd Environment= lines.

[Unit]
Description=Sillage, plateforme de developpement agentique
After=network.target
# Startup failing immediately will fail again: five attempts suffice to show it.
# Without this limit, `Restart=always` loops forever, flooding logs with identical
# cycles that hide the real error. Beyond it, unit becomes `failed` with
# “start request repeated too quickly”, the useful diagnosis. Window is wide
# relative to RestartSec so update restarts do not count as failures.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__/current
ExecStart=__NODE__ --max-old-space-size=256 __INSTALL_DIR__/current/server/main.js
Environment=NODE_ENV=production
Environment=SILLAGE_WEB_ROOT=__INSTALL_DIR__/current/web
# Tell server it runs under installer layout so it can offer integrated updates.
Environment=SILLAGE_INSTALL_DIR=__INSTALL_DIR__
# Systemd unit PATH is minimal, missing ~/.local/bin and global npm binaries:
# without this line no agent CLI would be found by the service.
Environment=PATH=__NODE_DIR__:__HOME__/.local/bin:__HOME__/.npm-global/bin:__HOME__/.bun/bin:/usr/local/bin:/usr/bin:/bin
# `always`, not `on-failure`: integrated updates may exit cleanly, relying on
# systemd to relaunch the new version.
Restart=always
RestartSec=2

# Guardrail, not reservation: beyond this, kernel throttles service instead of
# letting the entire machine run out of memory. Agents and their dev servers
# (vite, bun: several GB each) are children. Fixed caps suit no machine: at 2G,
# then 12G on a 62 GB machine, throttling froze daemon itself (D state) without
# killing anything, making Sillage unreachable. Hence a share of installed RAM.
# Override with `systemctl --user edit sillage`, then [Service] MemoryHigh=...
# That drop-in survives reinstalls; install.sh rewrites this file.
MemoryHigh=75%

# Use journal, not a file. For failed service startup the first check is
# `journalctl --user -u sillage`: systemd messages without application traces
# send investigation in the wrong direction. Systemd already manages rotation
# and retention, unlike `append:`.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sillage

[Install]
WantedBy=default.target
