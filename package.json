{
  "name": "sillage",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @sillage/server test",
    "test:api-mcp-ui": "node scripts/api-mcp-ui-check.mjs",
    "test:mcp-auth-ui": "node scripts/mcp-auth-ui-check.mjs",
    "test:codex-ui": "node scripts/codex-ui-check.mjs",
    "test:claude-sync-ui": "node --import ./apps/server/node_modules/tsx/dist/loader.mjs scripts/claude-sync-ui-check.mjs",
    "test:opencode-ui": "node scripts/opencode-ui-check.mjs",
    "test:grok-ui": "node scripts/grok-ui-check.mjs",
    "test:grok-accounts-ui": "node scripts/grok-accounts-ui-check.mjs",
    "test:antigravity-ui": "node scripts/antigravity-ui-check.mjs",
    "test:card-relations-ui": "node scripts/card-relations-ui-check.mjs",
    "test:card-tags-ui": "node scripts/card-tags-ui-check.mjs",
    "test:board-ui": "node scripts/board-ui-check.mjs",
    "test:cli-updates-ui": "node scripts/cli-updates-ui-check.mjs",
    "test:concentration-ui": "node scripts/concentration-ui-check.mjs",
    "test:composer-ui": "node scripts/composer-ui-check.mjs",
    "test:viewport-ui": "node scripts/viewport-ui-check.mjs",
    "test:skill-updates-ui": "node scripts/skill-updates-ui-check.mjs",
    "test:skills-navigation-ui": "node scripts/skills-navigation-ui-check.mjs",
    "test:skills-ui": "node scripts/skills-ui-check.mjs",
    "test:tooltips-ui": "node scripts/tooltips-ui-check.mjs",
    "test:git-ui": "node scripts/git-ui-check.mjs",
    "test:panel-empty-ui": "node scripts/panel-empty-ui-check.mjs",
    "test:checkpoints-ui": "node scripts/checkpoints-ui-check.mjs",
    "test:workspace-label-ui": "node scripts/workspace-label-ui-check.mjs",
    "test:palette-ui": "node scripts/palette-ui-check.mjs",
    "test:actions-ui": "node scripts/actions-ui-check.mjs",
    "test:automations-ui": "node scripts/automations-ui-check.mjs",
    "test:board-github-ui": "node scripts/board-github-ui-check.mjs",
    "test:decisions-ui": "node scripts/decisions-ui-check.mjs",
    "test:schedule-check-ui": "node scripts/schedule-check-ui-check.mjs",
    "test:images-ui": "node scripts/image-viewer-ui-check.mjs",
    "test:typing-indicator-ui": "node scripts/typing-indicator-ui-check.mjs",
    "test:tool-styles-ui": "node scripts/tool-styles-ui-check.mjs",
    "test:worktrees-ui": "node scripts/worktree-status-ui-check.mjs",
    "test:desktop-ui": "node scripts/desktop-ui-check.mjs",
    "test:desktop-mac-install": "node scripts/desktop-mac-install-check.mjs",
    "test:desktop-updates-ui": "node scripts/desktop-updates-ui-check.mjs",
    "test:desktop-update": "node scripts/desktop-update-check.mjs",
    "test:onboarding-ui": "node scripts/onboarding-ui-check.mjs",
    "test:windows-feedback-ui": "node scripts/windows-feedback-ui-check.mjs",
    "test:board-feedback-ui": "node scripts/board-feedback-ui-check.mjs",
    "test:session-references-ui": "node scripts/session-references-ui-check.mjs",
    "test:sidebar-resize-ui": "node scripts/sidebar-resize-ui-check.mjs",
