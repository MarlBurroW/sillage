{
  "name": "sillage",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @sillage/server test",
    "test:codex-ui": "node scripts/codex-ui-check.mjs",
    "test:opencode-ui": "node scripts/opencode-ui-check.mjs",
    "test:board-ui": "node scripts/board-ui-check.mjs",
    "test:composer-ui": "node scripts/composer-ui-check.mjs",
    "test:skills-ui": "node scripts/skills-ui-check.mjs",
    "test:tooltips-ui": "node scripts/tooltips-ui-check.mjs",
    "test:git-ui": "node scripts/git-ui-check.mjs",
    "test:palette-ui": "node scripts/palette-ui-check.mjs",
    "test:ui": "node scripts/frontend-ui-check.mjs",
    "db:generate": "pnpm --filter @sillage/db generate",
    "db:migrate": "pnpm --filter @sillage/server migrate",
    "user:create": "pnpm --filter @sillage/server user:create",
    "codex:types": "node scripts/codex-types.mjs",
    "codex:types:check": "node scripts/codex-types.mjs --check",
    "opencode:types": "node scripts/opencode-types.mjs",
    "opencode:types:check": "node scripts/opencode-types.mjs --check",
    "lint": "pnpm --filter @sillage/web lint"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3"
  }
}
