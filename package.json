{
  "name": "sillage",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @sillage/server test",
    "test:api-mcp-ui": "node scripts/api-mcp-ui-check.mjs",
    "test:codex-ui": "node scripts/codex-ui-check.mjs",
    "test:opencode-ui": "node scripts/opencode-ui-check.mjs",
    "test:board-ui": "node scripts/board-ui-check.mjs",
    "test:composer-ui": "node scripts/composer-ui-check.mjs",
    "test:viewport-ui": "node scripts/viewport-ui-check.mjs",
    "test:skill-updates-ui": "node scripts/skill-updates-ui-check.mjs",
    "test:skills-ui": "node scripts/skills-ui-check.mjs",
    "test:tooltips-ui": "node scripts/tooltips-ui-check.mjs",
    "test:git-ui": "node scripts/git-ui-check.mjs",
    "test:panel-empty-ui": "node scripts/panel-empty-ui-check.mjs",
    "test:checkpoints-ui": "node scripts/checkpoints-ui-check.mjs",
    "test:workspace-label-ui": "node scripts/workspace-label-ui-check.mjs",
    "test:palette-ui": "node scripts/palette-ui-check.mjs",
    "test:actions-ui": "node scripts/actions-ui-check.mjs",
    "test:automations-ui": "node scripts/automations-ui-check.mjs",
    "test:board-github-ui": "node scripts/board-github-ui-check.mjs",
    "test:decisions-ui": "node scripts/decisions-ui-check.mjs",
    "test:schedule-check-ui": "node scripts/schedule-check-ui-check.mjs",
    "test:images-ui": "node scripts/image-viewer-ui-check.mjs",
    "test:worktrees-ui": "node scripts/worktree-status-ui-check.mjs",
    "test:desktop-ui": "node scripts/desktop-ui-check.mjs",
    "test:onboarding-ui": "node scripts/onboarding-ui-check.mjs",
    "test:ui": "node scripts/frontend-ui-check.mjs",
    "db:generate": "pnpm --filter @sillage/db generate",
    "db:migrate": "pnpm --filter @sillage/server migrate",
    "user:create": "pnpm --filter @sillage/server user:create",
    "codex:types": "node scripts/codex-types.mjs",
    "codex:types:check": "node scripts/codex-types.mjs --check",
    "opencode:types": "node scripts/opencode-types.mjs",
    "opencode:types:check": "node scripts/opencode-types.mjs --check",
    "lint": "pnpm --filter @sillage/web lint"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3"
  }
}
